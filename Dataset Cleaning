library(DiscreteDatasets)
library(tidyverse)


airway <- DiscreteDatasets::airway

colnames(airway)
library(airway)
data("airway", package = "airway")
library(knitr) # Required to generate the formatted table

# Pull out the exact 8-sample data frame
airway_samples <- as.data.frame(assay(airway, "counts"))

# View it as a spreadsheet
View(airway_samples)
#combine  the 8  sample ids back into the intended two groups control and treatment

counts <-as.data.frame(assay(airway, "counts"))

#combines the even which are the  dexamethaone treated samples as "treated" and non treated as "control"
Ogairway<- data.frame( 
    Treatment = rowSums(counts[, c("SRR1039509", "SRR1039513", "SRR1039517", "SRR1039521")]),
    Control = rowSums(counts[,c("SRR1039508", "SRR1039512", "SRR1039516", "SRR1039520")]),
    row.names  = rownames(counts)


)

#filter out genes with no expression future create a list of the gens with no expression
Ogairway_NA_Expression <- Ogairway %>% 
filter(Treatment > 0 & Control > 0)
view(Ogairway_NA_Expression)

#check how many rows-AKA genes were removed
nrow(Ogairway)
#has total genes 63677
nrow(Ogairway_NA_Expression)
# total genes 27450

#numerically shows thsis
Ogairwaynum  = 63677
Ogairway_NA_ExpressionNum = 27450
Ogairwaynum - Ogairway_NA_ExpressionNum 
#36227 no expression to dexamsone
#fruther analysis of this data set stastically will happen later in the 6 months timeline utlizing bioconductor packages among other like the fold reads


# removes duplicate rows 
NoDup <-distinct(Ogairway_NA_Expression,keep_all = FALSE)
#remvoes values less than 10
 Lowexpression_Fil <- filter(Ogairway_NA_Expression, Treatment >= 10 & Control >= 10)
 View(Lowexpression_Fil)

 #slicng for high values
 Hg_EXP <-slice_max(Lowexpression_Fil,order_by = Treatment,n=400)
 View(Hg_EXP)
#slice of min values
 low_EXP <-slice_min(Lowexpression_Fil,order_by=Treatment,n=400)
View(low_EXP)
#what if we wanted to add a new gene to the data ?

# 1. Convert row names to a "Gene" column so they don't get deleted
Lowexpression_Fil_Safe <- rownames_to_column(Lowexpression_Fil, var = "Gene")

# 2 Find the exact row number for ENSG00000000003 (don't forget the quotes!)
target_row <- which(Lowexpression_Fil_Safe$Gene == "ENSG00000000003")

# 3 Add the new row 
Lowexpression_Updated <- Lowexpression_Fil_Safe %>%
  add_row(
    Gene = "MY_NEW_GENE",  
    Treatment = 100,       
    Control = 100,         
    .before = target_row
  )

#4 
View(Lowexpression_Updated)

#Combing varriables so we can in the future groups can be anaylized 
