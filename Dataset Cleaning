# 1. Convert row names to a Gene column so ggplot can see them
low_EXP_Safe <- rownames_to_column(low_EXP, var = "Gene")

# 2. Isolate EXACTLY 15 genes (turning off ties prevents the jumbled axis)
bottom_15 <- low_EXP_Safe %>% 
  slice_min(order_by = Treatment, n = 15, with_ties = FALSE)

# 3. Generate the Lollipop Chart
Plot_3_Final <- ggplot(bottom_15, aes(x = reorder(Gene, Treatment), y = Treatment)) +
  geom_segment(aes(xend = Gene, yend = 0), color = "gray60", linewidth = 1) +
  geom_point(color = "#e74c3c", size = 4) +
  coord_flip() +
  labs(
    title = "Floor Expression: Lowest Responding Genes",
    subtitle = "Absolute bottom 15 genes in the dexamethasone cohort",
    x = "Ensembl Gene ID",
    y = "Treated Counts"
  ) +
  theme_classic(base_size = 14)

